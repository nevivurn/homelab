launch=gpgsql
local-address=127.0.0.1, [::1]
local-port=5301
guardian=on
gpgsql-host=localhost
gpgsql-port=5000
gpgsql-dbname={{ pdns_postgres_db }}
gpgsql-user={{ pdns_postgres_user }}
gpgsql-password={{ pdns_postgres_pass }}
gpgsql-extra-connection-parameters=sslmode=verify-ca sslrootcert=/etc/powerdns/ssl/postgres-ca.crt
gpgsql-dnssec=on
webserver=on
api=on
api-key={{ pdns_api_key }}
